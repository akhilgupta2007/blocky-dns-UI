# BlockyDNS Hub Configuration
# Deployment Mode
INTEGRATION_MODE=all-in-one # "all-in-one" or "existing"

# Admin Authentication
ADMIN_USER=admin
ADMIN_PASSWORD=changeme123
JWT_SECRET=super_secret_blockydns_jwt_key_change_me

# Network Ports
HTTP_PORT=3000
HTTPS_PORT=3443
ENABLE_HTTPS=true
AUTO_REDIRECT_HTTP=true

# Database Configuration (sqlite or mysql)
DB_TYPE=sqlite
DB_PATH=/app/data/blockydns.db
# If using MySQL / MariaDB:
# DB_HOST=db
# DB_PORT=3306
# DB_USER=blocky
# DB_PASSWORD=blocky_pass
# DB_NAME=blocky_logs

# Blocky Engine Integration
BLOCKY_API_URL=http://blocky:4000
BLOCKY_CONFIG_PATH=/app/config/config.yml

# Log Retention (days)
LOG_RETENTION_DAYS=7

# Router IP for DHCP Reverse PTR resolution
ROUTER_IP=192.168.1.1
ROUTER_PTR_ENABLED=true
